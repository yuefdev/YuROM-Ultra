Subject: [PATCH] Complete wallpaper loading when object capture fails

--- a/smali_classes2/W1/f.smali
+++ b/smali_classes2/W1/f.smali
@@ -253,5 +253,9 @@
     invoke-static {v6, v0, v1}, LR3/b;->b(Ljava/lang/String;Ljava/lang/String;[Ljava/lang/Object;)Ljava/lang/String;

-    goto/16 :goto_3
+    # Complete with an empty result when native object capture fails.
+    # The editor must still receive its normal completion callback.
+    const/4 v0, 0x0
+
+    move-object v1, p0

     :cond_1
@@ -285,4 +289,6 @@

     invoke-direct {v7, v0, v8}, LW1/g;-><init>(Lcom/samsung/android/app/sdk/deepsky/wallpaper/objectcapture/ObjectResult;I)V
+
+    if-eqz v0, :cond_6

     invoke-virtual {v0}, Lcom/samsung/android/app/sdk/deepsky/wallpaper/objectcapture/ObjectResult;->isCaptured()Z

#!/sbin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Full-image clean installation on the measured original G973F layout.
set -u
OUTFD="${2:-}"
ZIP="${3:-}"
BLOCK_ROOT=/dev/block/by-name
SYS_BLOCK=/sys/class/block
DATA=/data
MOUNTS=/proc/mounts
WORK=

case "$OUTFD" in ''|*[!0-9]*) echo 'Invalid recovery output descriptor' >&2; exit 1 ;; esac
ui() { printf 'ui_print %s\nui_print\n' "$*" >&"$OUTFD"; }
abort() { ui "ERROR: $*"; exit 1; }
cleanup() { [ -z "$WORK" ] || rm -rf "$WORK"; }
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

ui 'YuROM Ultra One UI 9 - SM-G973F - BETA'
ui 'Clean installation only. No automatic userdata format.'
[ -f "$ZIP" ] || abort 'Recovery did not supply a readable ZIP.'
for tool in getprop unzip sha256sum dd head readlink awk mktemp sync; do
    command -v "$tool" >/dev/null 2>&1 || abort "Recovery is missing $tool."
done
[ -n "$(getprop ro.twrp.version)" ] || abort 'Install this package from TWRP.'
case "$(getprop ro.product.device)" in beyond1|beyond1lte) ;; *) abort 'Only Exynos SM-G973F is supported.' ;; esac
loader="$(getprop ro.bootloader)"
[ -n "$loader" ] || loader="$(getprop ro.boot.bootloader)"
case "$loader" in G973FXX[US][G-Z]*) ;; *) abort 'A G973F HWC1-base (revision G) or newer bootloader is required.' ;; esac
case "$(getprop ro.boot.flash.locked):$(getprop ro.boot.vbmeta.device_state)" in
    1:*|*:locked) abort 'An unlocked bootloader is required.' ;;
esac
awk -v data="$DATA" '$2 == data && $3 == "ext4" { found=1 } END { exit !found }' "$MOUNTS" ||
    abort 'Format Data in TWRP, then mount the fresh ext4 /data before installing.'
for directory in system system_ce system_de misc_ce misc_de user user_de data; do
    [ ! -e "$DATA/$directory" ] || abort 'Existing Android userdata found. Back up, then use TWRP Format Data first.'
done
ui 'Format Data removes apps, accounts and internal-storage files; this ZIP never performs it.'
WORK="$(mktemp -d /tmp/artisan-install.XXXXXX)" || abort 'Cannot create temporary installer directory.'
unzip -p "$ZIP" artisan/partitions.tsv > "$WORK/partitions.tsv" || abort 'Cannot read partition manifest.'
unzip -p "$ZIP" artisan/chunks.tsv > "$WORK/chunks.tsv" || abort 'Cannot read image manifest.'
# Enforce all six destinations, sequential chunks and bounded integers. awk
# avoids the signed 32-bit arithmetic used by some recovery shells.
awk '
    NR==FNR {
        if (NF!=3 || $1 !~ /^(vbmeta|system|vendor|dtb|dtbo|boot)$/ || seen[$1]++ ||
            $2 !~ /^[0-9]+$/ || $3 !~ /^[0-9]+$/ || $2<=0 || $3<=0 || $2>$3*512) exit 1
        total[$1]=$2; capacity[$1]=$3; parts++; next
    }
    {
        if (NF!=5 || !($1 in total) || $2 !~ /^[0-9]+$/ || $3 !~ /^[0-9]+$/ ||
            length($4)!=64 || $4 !~ /^[0-9a-f]+$/ || $2!=chunk_index[$1]*1024 ||
            $3<=0 || $3>1073741824 || final[$1] ||
            $5!="images/" $1 "/" sprintf("%04d",chunk_index[$1]) ".part") exit 1
        chunk_index[$1]++; bytes[$1]+=$3; if ($3<1073741824) final[$1]=1
    }
    END {
        if (parts!=6) exit 1
        for (part in total) if (bytes[part]!=total[part]) exit 1
    }
' "$WORK/partitions.tsv" "$WORK/chunks.tsv" || abort 'Invalid image topology or manifest.'

# Compare sector strings, not byte-sized shell integers. All checks and all
# payload hashes complete before the first partition write.
while read -r part bytes expected; do
    node="$BLOCK_ROOT/$part"
    [ -b "$node" ] || abort "Missing block device: $part"
    real="$(readlink -f "$node")" || abort "Cannot resolve $part."
    dev="${real##*/}"
    sectors="$(cat "$SYS_BLOCK/$dev/size" 2>/dev/null)"
    [ "$sectors" = "$expected" ] || abort "Unsupported $part partition size. This package does not repartition."
    [ ! -f "$WORK/device-$dev" ] || abort 'Two image targets resolve to the same block device.'
    : > "$WORK/device-$dev"
    while read -r source point rest; do
        resolved="$(readlink -f "$source" 2>/dev/null)" || resolved=
        [ "$resolved" != "$real" ] || abort "Unmount $point in TWRP before installing."
        case "$point" in /system|/system_root|/vendor) abort "Unmount $point in TWRP before installing." ;; esac
    done < "$MOUNTS"
done < "$WORK/partitions.tsv"
ui 'Checking every image chunk before flashing. This can take several minutes.'
while read -r part offset bytes expected entry; do
    actual="$(unzip -p "$ZIP" "$entry" | sha256sum)" || abort "Cannot read $entry."
    [ "${actual%% *}" = "$expected" ] || abort "Corrupt image chunk: $entry"
done < "$WORK/chunks.tsv"

ui 'Verified. Writing system, vendor, boot, DTB, DTBO and disabled-AVB metadata.'
while read -r part offset bytes expected entry; do
    ui "Installing $part (offset $offset MiB)..."
    unzip -p "$ZIP" "$entry" | dd of="$BLOCK_ROOT/$part" bs=1048576 seek="$offset" conv=notrunc,fsync 2>/dev/null ||
        abort "Write failed: $part. Restore the matching TWRP backup before booting."
    count="$(awk -v bytes="$bytes" 'BEGIN { print int((bytes+1048575)/1048576) }')"
    actual="$(dd if="$BLOCK_ROOT/$part" bs=1048576 skip="$offset" count="$count" 2>/dev/null | head -c "$bytes" | sha256sum)" ||
        abort "Cannot verify $part."
    [ "${actual%% *}" = "$expected" ] || abort "Readback mismatch: $part. Restore the matching TWRP backup before booting."
done < "$WORK/chunks.tsv"
sync || abort 'Final filesystem sync failed.'
ui 'Installation and block-device readback passed.'
ui 'Userdata, EFS, modem, bootloader and recovery were not written.'
ui 'Reboot System manually. First boot can take several minutes.'
exit 0

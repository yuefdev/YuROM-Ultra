{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "artisanrom-telemetry",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": false },
  "workers_dev": true,
  "preview_urls": false,
  "ratelimits": [
    { "name": "INGEST_LIMITER", "namespace_id": "1782061301", "simple": { "limit": 120, "period": 60 } }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "artisanrom-telemetry", "database_id": "69ba19c1-d6f1-4cd8-81ed-9945584c924d" }
  ],
  "triggers": { "crons": ["15 3 * * *"] }
}
